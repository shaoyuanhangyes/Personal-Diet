<view class="page food-page" bindtap="closeEditOnOutside">
  <view class="app-header">
    <view class="title-block">
      <view class="title">饮食清单</view>
      <view class="subtitle">维护今日餐食可选择的食物数据库</view>
    </view>
    <view class="icon-button add-food-button" bindtap="openAddSheet" role="button" aria-label="添加食物">＋</view>
  </view>

  <view class="toolbar">
    <input class="search-input" placeholder="搜索食物" value="{{search}}" bindinput="inputSearch" />
    <view class="unit-switch">
      <view class="unit-option {{kcalActive}}" data-unit="kcal" bindtap="changeUnit" role="button">kcal</view>
      <view class="unit-option {{kjActive}}" data-unit="kJ" bindtap="changeUnit" role="button">kJ</view>
    </view>
  </view>

  <view class="card food-table">
    <view class="card-header">
      <view class="card-title">食物数据库</view>
      <view class="muted">{{foodCountText}}</view>
    </view>
    <view wx:if="{{noFoods}}" class="empty-state">没有找到食物</view>
    <block wx:if="{{hasFoods}}">
      <block wx:for="{{foods}}" wx:key="id">
        <view class="{{item.rowClass}}" data-id="{{item.id}}" catchtap="selectFood">
          <view class="food-main">
            <view class="food-avatar" wx:if="{{item.noImage}}">{{item.initial}}</view>
            <image wx:if="{{item.hasImage}}" class="food-avatar image" mode="aspectFill" src="{{item.image}}"></image>
            <view class="food-info">
              <view class="food-title-row">
                <text class="food-name">{{item.name}}</text>
              </view>
              <view class="food-energy">{{item.energy}}</view>
              <view class="food-meta" wx:if="{{item.readonly}}">
                <text>碳水 {{item.carbsText}}g</text>
                <text>蛋白质 {{item.proteinText}}g</text>
                <text>脂肪 {{item.fatText}}g</text>
                <text>规格 {{item.spec}}</text>
                <text>{{item.quantityText}}</text>
              </view>
              <view class="food-edit-grid" wx:if="{{item.editing}}" catchtap="stopEditTap">
                <input data-id="{{item.id}}" data-field="name" value="{{item.name}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="carbs" type="digit" value="{{item.carbsValue}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="protein" type="digit" value="{{item.proteinValue}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="fat" type="digit" value="{{item.fatValue}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="energy" type="digit" placeholder="能量 {{unit}}（可选）" value="{{item.energyValue}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="coefficient" type="digit" value="{{item.coefficientValue}}" bindinput="editFood" />
                <input data-id="{{item.id}}" data-field="quantity" type="digit" value="{{item.quantityValue}}" bindinput="editFood" />
                <input wx:if="{{!item.hasNutritionBasis}}" data-id="{{item.id}}" data-field="unit" value="{{item.unitValue}}" bindinput="editFood" />
                <text wx:if="{{item.hasNutritionBasis}}">营养值按{{item.unit === '个' ? '每包装' : '每100' + item.measureUnit}}编辑，单位由规格自动确定</text>
              </view>
            </view>
          </view>
          <view class="food-actions">
            <view class="edit-button" data-id="{{item.id}}" catchtap="toggleEdit" role="button" aria-label="编辑食物">
              <view class="{{item.editIconClass}}">
                <view class="edit-stem"></view>
                <view class="edit-tip"></view>
              </view>
            </view>
            <view class="delete-button" data-id="{{item.id}}" catchtap="deleteFood" role="button" aria-label="删除食物">
              <view class="trash-icon">
                <view class="trash-lid"></view>
                <view class="trash-can">
                  <view class="trash-line"></view>
                  <view class="trash-line"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
    <view wx:if="{{showPagination}}" class="pagination">
      <view class="page-button {{prevDisabled ? 'is-disabled' : ''}}" bindtap="prevPage" role="button" aria-disabled="{{prevDisabled}}">上一页</view>
      <view class="page-text">{{pageText}}</view>
      <view class="page-button {{nextDisabled ? 'is-disabled' : ''}}" bindtap="nextPage" role="button" aria-disabled="{{nextDisabled}}">下一页</view>
    </view>
  </view>

  <view wx:if="{{addVisible}}" class="add-sheet" bindtap="closeAddSheet">
    <view class="sheet-backdrop"></view>
    <view class="sheet-panel" catchtap="stopSheetTap">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <view class="card-title">添加食物</view>
        <view class="icon-button small close-sheet-button" bindtap="closeAddSheet" role="button" aria-label="关闭添加食物">×</view>
      </view>
      <view class="nutrition-scan">
        <view class="nutrition-scan-title">拍照识别营养成分表</view>
        <view class="nutrition-scan-actions">
          <button class="nutrition-scan-button" data-source="camera" bindtap="chooseNutritionPhoto" loading="{{ocrLoading}}" disabled="{{ocrLoading}}">打开摄像头</button>
          <button class="nutrition-scan-button" data-source="album" bindtap="chooseNutritionPhoto" disabled="{{ocrLoading}}">上传照片</button>
        </view>
        <view class="nutrition-scan-hint">识别结果会按成分表标注的每100g、每100ml或每份填入表单，请核对后填写食物名称和最小包装规格。</view>
      </view>
      <view class="sheet-form">
        <view class="sheet-field">
          <text class="sheet-field-label">食物名称</text>
          <input class="sheet-field-input" placeholder="请输入" aria-label="食物名称" data-field="name" value="{{newFood.name}}" adjust-position="{{false}}" bindinput="inputNewFood" />
        </view>
        <view class="sheet-field">
          <text class="sheet-field-label">碳水化合物</text>
          <input class="sheet-field-input" placeholder="请输入" type="digit" aria-label="碳水化合物" data-field="carbs" value="{{newFood.carbs}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">g/{{newFood.quantity || 100}}{{newFood.measureUnit}}</text>
        </view>
        <view class="sheet-field">
          <text class="sheet-field-label">蛋白质</text>
          <input class="sheet-field-input" placeholder="请输入" type="digit" aria-label="蛋白质" data-field="protein" value="{{newFood.protein}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">g/{{newFood.quantity || 100}}{{newFood.measureUnit}}</text>
        </view>
        <view class="sheet-field">
          <text class="sheet-field-label">脂肪</text>
          <input class="sheet-field-input" placeholder="请输入" type="digit" aria-label="脂肪" data-field="fat" value="{{newFood.fat}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">g/{{newFood.quantity || 100}}{{newFood.measureUnit}}</text>
        </view>
        <view class="sheet-field">
          <text class="sheet-field-label">能量</text>
          <input class="sheet-field-input" placeholder="可选" type="digit" aria-label="能量" data-field="energy" value="{{newFood.energy}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">{{unit}}/{{newFood.quantity || 100}}{{newFood.measureUnit}}</text>
        </view>
        <view wx:if="{{ocrReview}}" class="nutrition-review">请核对识别结果，特别是规格和能量单位；食物名称需要手动填写。</view>
        <view class="sheet-field">
          <text class="sheet-field-label">最小包装{{newFood.measureUnit === 'ml' ? '容量' : '重量'}}</text>
          <input class="sheet-field-input" placeholder="无包装填 1" type="digit" aria-label="最小包装{{newFood.measureUnit === 'ml' ? '容量' : '重量'}}" data-field="coefficient" value="{{newFood.coefficient}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">{{newFood.measureUnit}}</text>
        </view>
        <view class="sheet-field">
          <text class="sheet-field-label">营养标示基准</text>
          <input class="sheet-field-input" placeholder="例如 100" type="digit" aria-label="营养标示基准" data-field="quantity" value="{{newFood.quantity}}" adjust-position="{{false}}" bindinput="inputNewFood" />
          <text class="sheet-field-unit">{{newFood.measureUnit}}</text>
        </view>
        <view class="nutrition-scan-hint">最小包装填 1{{newFood.measureUnit}} 时，餐食按{{newFood.measureUnit === 'ml' ? '毫升' : '克'}}计算；大于 1{{newFood.measureUnit}} 时，按最小包装数量计算。营养标示基准填成分表注明的“每多少{{newFood.measureUnit === 'ml' ? '毫升' : '克'}}”。</view>
        <button class="primary-button" bindtap="addFood">保存食物</button>
        <view class="status-text">{{status}}</view>
      </view>
    </view>
  </view>
</view>
